+/// `snapshot_id` and `capture_id` are registered after the summary line is
+/// built. Clients that keep only text content never see `structuredContent`,
+/// so both ids are appended to the first text line when present. An image-only
+/// response gets a one-line summary inserted at the front.
+fn append_observation_ids(
+    content: &mut Vec<cua_driver_core::protocol::Content>,
+    snapshot_id: Option<&str>,
+    capture_id: Option<&str>,
+    fallback_header: &str,
+) {
+    let mut extra = String::new();
+    if let Some(sid) = snapshot_id.filter(|sid| !sid.is_empty()) {
+        extra.push_str(&format!(" snapshot_id={sid}"));
+    }
+    if let Some(cid) = capture_id.filter(|cid| !cid.is_empty()) {
+        extra.push_str(&format!(" capture_id={cid}"));
+    }
+    if extra.is_empty() {
+        return;
+    }
+    if let Some(cua_driver_core::protocol::Content::Text { text, .. }) = content
+        .iter_mut()
+        .find(|part| matches!(part, cua_driver_core::protocol::Content::Text { .. }))
+    {
+        match text.find('\n') {
+            Some(index) => text.insert_str(index, &extra),
+            None => text.push_str(&extra),
+        }
+        return;
+    }
+    if content.is_empty() {
+        return;
+    }
+    let mut line = fallback_header.trim_end().to_string();
+    if line.is_empty() {
+        return;
+    }
+    line.push_str(&extra);
+    content.insert(0, cua_driver_core::protocol::Content::text(line));
+}
