+fn format_visual_regions_text(output: &ParseVisualRegionsOutput) -> String {
+    let mut lines = vec![format!(
+        "Parsed {} visual regions capture_id={}",
+        output.regions.len(),
+        output.capture.capture_id
+    )];
+    for region in &output.regions {
+        let kind = match region.kind {
+            VisualRegionKind::Text => "text",
+            VisualRegionKind::Icon => "icon",
+        };
+        let b = &region.bounds;
+        let (cx, cy) = b.center();
+        let mut line = format!(
+            "id={} kind={} bounds={},{},{},{} center={},{} confidence={:.3}",
+            region.id, kind, b.x, b.y, b.width, b.height, cx, cy, region.confidence
+        );
+        if let Some(text) = region.text.as_deref().filter(|s| !s.is_empty()) {
+            let escaped = serde_json::to_string(text).unwrap_or_else(|_| format!("{text:?}"));
+            line.push_str(&format!(" text={escaped}"));
+        }
+        if let Some(label) = region.label.as_deref().filter(|s| !s.is_empty()) {
+            let escaped = serde_json::to_string(label).unwrap_or_else(|_| format!("{label:?}"));
+            line.push_str(&format!(" label={escaped}"));
+        }
+        lines.push(line);
+    }
+    lines.join("\n")
+}
